# Ölçekhane yayın ayarları. Bu dosyada GİZLİ BİLGİ YOKTUR; buradaki şirket bilgileri ve alan adı sitede
# herkese açık olarak görünür. Gizli değerler (ANA_SIFRE, sunucuların root şifreleri, SMTP şifresi)
# GitHub'da depo ayarlarındaki Secrets bölümünde durur (yayin/REHBER.md).
#
# Bu dosya değişip GitHub'a gönderildiğinde denetimden sonra yayın kendiliğinden yenilenir.
# Değerler tırnaksız yazılabilir; boşluk ya da # içeren değerleri tek tırnak içine alın.

# --- Sunucular (IP adresleri gizli değildir) ---
# Ana sunucunun IPv4 adresi. Boşken yayın iş akışı hiçbir şey yapmaz.
SUNUCU_ADRESI=
# Yedeklerin şifreli kopyasını çeken depolama sunucusunun IPv4 adresi (boşsa atlanır).
DEPO_ADRESI=

# --- Site ---
SITE_DOMAIN=olcekhane.com
# Let's Encrypt sertifika bildirimleri için e-posta.
ACME_EMAIL=
# Arama motorlarına açık mı: pilot süresince false, resmî açılışta true.
ALLOW_INDEXING=false

# --- E-posta ---
MAIL_FROM='Ölçekhane <bilgi@olcekhane.com>'
# SMTP sunucusu ve portu (465: SSL, 587: STARTTLS). Kullanıcı adı ve şifre GitHub Secrets'ta:
# SMTP_KULLANICI, SMTP_SIFRE.
SMTP_SUNUCU=proxy.uzmanposta.com
SMTP_PORT=465
# Sağlayıcının gönderim sınırlarının biraz altında: aşan e-postalar kuyrukta bekleyip sonra gönderilir.
MAIL_RATE_PER_HOUR=90
MAIL_RATE_PER_DAY=900

# --- Platform yöneticisi ---
# Bu adresle yönetici hesabı açılır (şifre "Şifremi unuttum" ile belirlenir). Hesap zaten varsa
# dokunulmaz.
ADMIN_EMAIL=
ADMIN_NAME='Platform Yöneticisi'

# --- Şirket bilgileri (aydınlatma metni ve site altbilgisi; veri sorumlusu) ---
COMPANY_LEGAL_NAME=
COMPANY_ADDRESS=
COMPANY_MERSIS=
COMPANY_TAX_OFFICE=
COMPANY_TAX_NO=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_KVKK_EMAIL=
COMPANY_KEP=

# --- Yedekler ---
# Yedeklerin sunucuda kaç gün saklanacağı (1–28) ve alınma saati (Türkiye saati).
BACKUP_KEEP_DAYS=14
BACKUP_TIME=03:15
