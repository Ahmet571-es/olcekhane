# Ölçekhane yayın ayarları. Bu dosyada GİZLİ BİLGİ YOKTUR; buradaki site sahibi bilgileri ve alan adı sitede
# herkese açık olarak görünür. Gizli değerler (ANA_SIFRE ve ilk kurulum için sunucunun root şifresi)
# GitHub'da depo ayarlarındaki Secrets bölümünde durur (yayin/REHBER.md).
#
# Bu dosya değişip GitHub'a gönderildiğinde denetimden sonra yayın kendiliğinden yenilenir.
# Değerler tırnaksız yazılabilir; boşluk ya da # içeren değerleri tek tırnak içine alın.

# --- Sunucu (IP adresi gizli değildir) ---
# Sunucunun IPv4 adresi. Boşken yayın iş akışı hiçbir şey yapmaz.
SUNUCU_ADRESI=179.198.215.72

# --- Site ---
SITE_DOMAIN=olcekhane.com
# Let's Encrypt sertifika bildirimleri için e-posta.
ACME_EMAIL=teknik@olcekhane.com
# Arama motorlarına açık mı: hazırlık süresince false, resmî açılışta true.
ALLOW_INDEXING=true

# --- Site sahibi (Ölçekhane'yi bireysel olarak işleten kişi; KVKK'da veri sorumlusu) ---
# Yasa gereği (5651 sayılı Kanun'a dayanan yönetmelik, m.5) İletişim sayfasında ve aydınlatma metninde
# gösterilir. Bu dört alan zorunludur: boşken site arama motorlarına açılamaz (ALLOW_INDEXING=true).
# Site sahibinin kararıyla (30 Eylül 2026) site, bilgiler kısa süre içinde eklenmek üzere Google'a açıldı. Dört
# alan doldurulunca bu satır silinir.
SAHIP_BILGILERI_SONRA=true
OWNER_NAME=
OWNER_ADDRESS=
OWNER_PHONE=
OWNER_EMAIL=
# İsteğe bağlı: KVKK başvuruları için ayrı bir e-posta (boşsa OWNER_EMAIL kullanılır) ve KEP adresi.
OWNER_KVKK_EMAIL=
OWNER_KEP=
# Vergi kaydından sonra (ücretli rapor satışına başlamadan önce) doldurulur.
OWNER_TAX_OFFICE=
OWNER_TAX_NO=
