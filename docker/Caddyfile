# Ölçekhane: Caddy ters vekil sunucusu (HTTPS sertifikası Let's Encrypt'ten kendiliğinden alınır ve yenilenir).
# SITE_DOMAIN ve ACME_EMAIL, docker-compose.yml aracılığıyla .env dosyasından gelir.

{
	email {$ACME_EMAIL}
	# Günlüğe yalnızca ayar, yönetim ve sertifika iletileri yazılır (izin listesi). Caddy isteklerle ilgili
	# iletileri (ör. uygulama yeniden başlarken dönen 502: http.log.error; ziyaretçi PDF inerken sayfadan
	# ayrılınca: http.handlers.reverse_proxy) istemcinin IP adresi, istenen adres ve başlıklarıyla birlikte
	# yazar; bunlar ve Caddy'nin ileride ekleyebileceği başka istek günlükleri de yazılmaz (aydınlatma metni:
	# ziyaretlerin kaydı tutulmaz). Erişim günlüğü de kapalıdır.
	log default {
		include admin caddyfile tls pki http.auto_https
	}
	# Yalnızca deneme kurulumlarında (kurulum provası): "local_certs" ile sertifikalar Caddy'nin kendi
	# yerel sertifika yetkilisinden alınır. Gerçek kurulumda boştur (Let's Encrypt).
	{$CADDY_GENEL_AYAR}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		# Tarayıcı bu alan adına bir yıl boyunca yalnızca HTTPS ile bağlansın.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy app:3000 {
		# İstemcinin IP adresi: istemcinin kendisinin gönderebileceği X-Forwarded-For değerine güvenilmez,
		# Caddy'nin gördüğü adresle değiştirilir (bellekteki hız sınırı bu adresi kullanır).
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}

	# Erişim günlüğü bilerek kapalıdır: ziyaretlerin kaydı tutulmaz (aydınlatma metni).
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
