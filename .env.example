# Ölçekhane ortam değişkenleri. Bu dosyayı .env adıyla kopyalayıp doldurun; .env dosyasını asla
# paylaşmayın ya da depoya eklemeyin. Değiştirdikten sonra: docker compose up -d

# --- Alan adı ve HTTPS ---
# Sitenin alan adı (www olmadan). DNS A kaydı bu sunucunun IP adresini göstermeli.
SITE_DOMAIN=olcekhane.com
# Let's Encrypt sertifika bildirimleri için e-posta.
ACME_EMAIL=teknik@olcekhane.com
# Sitenin tam adresi: e-postalardaki bağlantılar, site haritası ve paylaşım kartları bununla üretilir.
APP_URL=https://olcekhane.com

# --- Gizli anahtarlar (üretmek için: openssl rand -hex 32) ---
# Veritabanı şifresi: yalnızca harf ve rakam kullanın (bağlantı adresine yazıldığı için).
POSTGRES_PASSWORD=
# Uygulama anahtarı (en az 32 karakter): öğrenci giriş kodları ve kurtarma kodlarının özetleri, iki
# aşamalı doğrulama sırlarının şifrelenmesi. Kurulumdan sonra DEĞİŞTİRMEYİN: değişirse bütün öğrenci
# kodları ve iki aşamalı doğrulama kurulumları geçersiz olur. Güvenli ve ayrı bir yerde yedekleyin.
APP_SECRET=

# --- E-posta (SMTP) ---
# Örnek: smtps://kullanici:sifre@smtp.saglayici.com.tr:465
# Tanımlı değilse e-postalar gönderilmez, yalnızca yönetim panelindeki e-posta kutusuna yazılır.
SMTP_URL=
MAIL_FROM=Ölçekhane <bilgi@olcekhane.com>
# Gönderim sınırı: sağlayıcının saatlik ve günlük sınırının biraz altında tutun (ör. sağlayıcı saatte 100
# diyorsa 90). Sınırı aşan e-postalar sırada bekler ve sınır açıldıkça gönderilir; saatlik sınırın %10'u
# doğrulama, şifre yenileme ve güvenlik bildirimlerine ayrılır. Geçici hatalarda iki güne kadar yeniden denenir.
MAIL_RATE_PER_HOUR=90
MAIL_RATE_PER_DAY=900

# --- Şirket bilgileri (aydınlatma metni ve site altbilgisinde zorunlu) ---
COMPANY_LEGAL_NAME=
COMPANY_ADDRESS=
COMPANY_MERSIS=
COMPANY_TAX_OFFICE=
COMPANY_TAX_NO=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_KVKK_EMAIL=
COMPANY_KEP=

# --- Diğer ayarlar ---
# Hazırlık ortamında arama motorlarına kapatmak için false (yayında true).
ALLOW_INDEXING=true
# Günlük temizlik görevi (KVKK saklama süreleri). Üretimde açık kalmalı.
SCHEDULED_JOBS=true
# Veritabanı yedekleri: kaç gün saklanacağı ve alınma saati. En fazla 28 gün: silinen veriler yedeklerden
# de en geç 30 gün içinde çıkmalı (aydınlatma metni).
BACKUP_KEEP_DAYS=14
BACKUP_TIME=03:15
# Veritabanı bağlantı havuzu (varsayılan 10).
# DATABASE_POOL_SIZE=10
