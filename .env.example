# Ölçekhane ortam değişkenleri. Bu dosyayı .env adıyla kopyalayıp doldurun; .env dosyasını depoya
# eklemeyin. Değiştirdikten sonra: docker compose up -d
#
# Sitede veritabanı, hesap ve e-posta gönderimi yoktur; bu yüzden şifre ya da gizli anahtar gerekmez.

# --- Alan adı ve HTTPS ---
# Sitenin alan adı (www olmadan). DNS A kaydı bu sunucunun IP adresini göstermeli.
SITE_DOMAIN=olcekhane.com
# Let's Encrypt sertifika bildirimleri için e-posta.
ACME_EMAIL=teknik@olcekhane.com
# Sitenin tam adresi: site haritası, PDF raporların alt bilgisi ve paylaşım kartları bununla üretilir.
APP_URL=https://olcekhane.com

# --- Site sahibi (siteyi bireysel olarak işleten kişi; bkz. src/lib/site.ts) ---
# Yasa gereği İletişim sayfasında ve aydınlatma metninde gösterilir; ilk dördü zorunludur.
OWNER_NAME=
OWNER_ADDRESS=
OWNER_PHONE=
OWNER_EMAIL=
# İsteğe bağlı: KVKK başvuruları için ayrı e-posta (boşsa OWNER_EMAIL), KEP adresi.
OWNER_KVKK_EMAIL=
OWNER_KEP=
# Vergi kaydından sonra (ücretli rapor satışından önce).
OWNER_TAX_OFFICE=
OWNER_TAX_NO=

# --- Diğer ayarlar ---
# Hazırlık ortamında arama motorlarına kapatmak için false (yayında true).
ALLOW_INDEXING=true
